<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بطاقة دعوة زفاف</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital@0;1&family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f7f3e9;
            font-family: 'Cairo', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: #4a3b32;
            overflow: hidden;
        }

        .invitation-card {
            background-color: #fff;
            width: 90%;
            max-width: 500px;
            padding: 40px;
            text-align: center;
            border: 2px solid #c5a059;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            animation: fadeIn 2s ease-in;
        }

        .quran-verse {
            font-family: 'Amiri', serif;
            font-style: italic;
            font-size: 1.2rem;
            color: #c5a059;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .names h2 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: #4a3b32;
            letter-spacing: 2px;
        }

        .couple {
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 30px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            color: #332720;
        }

        .and {
            font-family: 'Amiri', serif;
            font-size: 1.4rem;
            color: #c5a059;
        }

        .details p {
            font-size: 1.1rem;
            margin-bottom: 12px;
            line-height: 1.8;
        }

        .date, .location {
            font-weight: bold;
            color: #c5a059;
        }

        .footer {
            margin-top: 35px;
            font-size: 1.1rem;
            color: #4a3b32;
            border-top: 1px solid #e2dacf;
            padding-top: 20px;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

    <div class="invitation-card">
